<?xml version="1.0" encoding="utf-8"?>
<!-- Household data stays on-device (PRD section 9 / section 10.2). Backup and device-transfer
     are fully excluded until the backup decision is reviewed before release. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
